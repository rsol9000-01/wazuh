@@ -50,8 +50,15 @@
 
     <skip_nfs>yes</skip_nfs>
 
-    <ignore>/var/lib/containerd</ignore>
-    <ignore>/var/lib/docker/overlay2</ignore>
+    <!-- The agent runs in Docker: check the server files mounted read-only at
+         /host, not the agent image. Processes, ports and interfaces are
+         already the host ones (pid: host and network_mode: host). -->
+    <base_directory>/host</base_directory>
+
+    <ignore>/host/sys</ignore>
+    <ignore>/host/proc</ignore>
+    <ignore>/host/var/lib/containerd</ignore>
+    <ignore>/host/var/lib/docker</ignore>
   </rootcheck>
 
   <wodle name="cis-cat">
@@ -94,10 +101,14 @@
     <packages>yes</packages>
     <ports all="yes">yes</ports>
     <processes>yes</processes>
-    <users>yes</users>
-    <groups>yes</groups>
-    <services>yes</services>
-    <browser_extensions>yes</browser_extensions>
+    <!-- The agent runs in Docker. Host data: hardware, os, network, ports,
+         processes and dpkg packages. Users, groups and services would
+         describe the agent image, so they are off. Browser extensions do
+         not apply to a server. -->
+    <users>no</users>
+    <groups>no</groups>
+    <services>no</services>
+    <browser_extensions>no</browser_extensions>
 
     <!-- Database synchronization settings -->
     <synchronization>
