# =====================================================================
# CONFIGURATION INSTRUCTIONS:
# ---------------------------------------------------------------------
# - Agent Mode: When deploying the project in Agent mode, you only 
#   need to set the first 4 variables.
# - Server Mode: When deploying in Server mode, all variables must be 
#   set, except for those marked as DO NOT EVER CHANGE.
# =====================================================================
REMOTE_AGENT_MANAGER_SERVER=<IP_O_FQDN_DEL_MANAGER>
AGENT_AUTH_PASSWORD=CAMBIAR
REMOTE_AGENT_GROUP=databus

# ── Solo en el .env del host de un agente remoto (R2 o R3) ───────────
# Es la ruta de ESE host; sale del bind mount del compose del agente.
# Tiene que coincidir con DATABUS_PATH o INFOBUS_PATH segun el servidor.  
PROJECT_PATH=/home/databus

# ── Rutas de los despliegues monitoreados ────────────────────────────
# Las cuatro las usa wazuh-manager-conf.sh (corre en R4) para construir
# el agent.conf de cada grupo. Son rutas EN EL HOST DE CADA AGENTE.
DATABUS_PATH=/home/databus       
INFOBUS_PATH=/home/infobus       
WAZUH_PATH=/home/wazuh           
ZABBIX_PATH=/home/zabbix

# ── Credenciales ──────────────────────────────────────────────────────
# Reemplazar TODOS los "CAMBIAR" antes de desplegar. wazuh-dev.sh rechaza
# AGENT_AUTH_PASSWORD, API_PASSWORD y DASHBOARD_PASSWORD si no cumplen:
# 8-64 caracteres, mayúscula, minúscula, dígito y uno de . * + ? -
# (sin $ | & \). Nunca versionar el .env real.
MY_USERNAME=tfgadmin
MY_PASSWORD=CAMBIAR
INDEXER_PASSWORD=CAMBIAR
API_PASSWORD=CAMBIAR
DASHBOARD_PASSWORD=CAMBIAR

# =====================================================================
# DO NOT EVER CHANGE
# ---------------------------------------------------------------------
# - DOCKER_GID is set by wazuh-dev.sh script, dont touch !!!
# - 'LOCAL_AGENT_HOSTNAME=localhost' is used to set a real hostname to 
#   the agents !!!
# =====================================================================
TZ=America/Costa_Rica
DASHBOARD_USERNAME=kibanaserver
INDEXER_USERNAME=admin
API_USERNAME=wazuh-wui
API_URL=https://wazuh.manager:55000
CONFIG_AGENT_SCRIPT=scripts/wazuh-agent-conf.sh
CONFIG_SERVER_SCRIPT=scripts/wazuh-manager-conf.sh
WAZUH_API_INSECURE=1
LOCAL_AGENT_GROUP=monitoring
DOCKER_GID=996
LOCAL_AGENT_HOSTNAME=localhost