# ── Rutas de los despliegues monitoreados ────────────────────────────
# Las cuatro las usa wazuh-manager-conf.sh (corre en R4) para construir
# el agent.conf de cada grupo. Son rutas EN EL HOST DE CADA AGENTE.
DATABUS_PATH=/home/databus       
INFOBUS_PATH=/home/infobus       
WAZUH_PATH=/home/wazuh           
ZABBIX_PATH=/home/zabbix
# ── Solo en el .env del host de un agente remoto (R2 o R3) ───────────
# Es la ruta de ESE host; sale del bind mount del compose del agente.
# Tiene que coincidir con DATABUS_PATH o INFOBUS_PATH segun el servidor.        
PROJECT_PATH=/home/databus

# ------ Change only if you know what you are doing, otherwise leave it as is.
TZ=America/Costa_Rica
DASHBOARD_USERNAME=kibanaserver
INDEXER_USERNAME=admin
API_USERNAME=wazuh-wui
API_URL=https://wazuh.manager:55000
CONFIG_AGENT_SCRIPT=scripts/wazuh-agent-conf.sh
CONFIG_SERVER_SCRIPT=scripts/wazuh-manager-conf.sh
DOCKER_GID=996
LOCAL_AGENT_HOSTNAME=localhost
WAZUH_API_INSECURE=1
LOCAL_AGENT_GROUP=monitoring